table CSSF
	lineageTag: 45307068-6a95-42d4-8ee3-53ec82c31f32

	measure 'UCI count' = VAR p = MAX(CSSF[month]) RETURN CALCULATE(SELECTEDVALUE(CSSF[uci_count]), CSSF[month] = p)
		formatString: #,0
		lineageTag: 52235612-c48b-44d8-87ce-2a89a73728f0

	measure 'Net assets EUR bn' = VAR p = MAX(CSSF[month]) RETURN CALCULATE(SELECTEDVALUE(CSSF[net_assets]), CSSF[month] = p)
		formatString: #,0.0
		lineageTag: 22596d37-e43e-4780-aec2-6c2b33f42366

	measure 'Net inflow EUR bn' = VAR p = MAX(CSSF[month]) RETURN CALCULATE(SELECTEDVALUE(CSSF[net_issuance]), CSSF[month] = p)
		formatString: #,0.0
		lineageTag: 36028587-2f8f-4616-8d8a-6ac644f42314

	measure 'UCI count display' = IF(ISBLANK([UCI count]), BLANK(), FORMAT([UCI count], "#,0"))
		lineageTag: 6660f6ad-6db6-4617-a11f-d796c10525bc

	measure 'Net assets EUR bn display' = IF(ISBLANK([Net assets EUR bn]), BLANK(), FORMAT([Net assets EUR bn], "#,0.0"))
		lineageTag: ac5a98f3-9728-4d1c-9882-d99e73415679

	measure 'Net inflow EUR bn display' = IF(ISBLANK([Net inflow EUR bn]), BLANK(), FORMAT([Net inflow EUR bn], "#,0.0"))
		lineageTag: e1c20db4-a683-4487-9e9a-d513be5f1426

